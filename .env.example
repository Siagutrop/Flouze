# PostgreSQL
POSTGRES_USER=flouze
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flouze

# API
JWT_SECRET=change-me-long-random-string
CORS_ORIGIN=http://localhost

# Passkeys / WebAuthn — domaine de prod (sans https://) et origine complète
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost

# Notifications push (optionnel — sinon auto-générées au 1er démarrage)
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# Web
WEB_PORT=80
